# ---------------------------------------------------------------------------
# AI Engine — Module A Demo
# ---------------------------------------------------------------------------
# Set this in your deployment environment to point at the real service.
# For local development the FastAPI service must be running on port 8000.
# Start it with:  cd services/ai-engine && uvicorn main:app --reload
# ---------------------------------------------------------------------------
NEXT_PUBLIC_AI_ENGINE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# AI Engine — LLM (optional enhancement)
# ---------------------------------------------------------------------------
# If set, the /ingest endpoint uses Llama 3-8b via Groq Cloud to generate
# the narration script. Without this, a fully local extractive fallback is
# used instead. The endpoint always succeeds regardless of this key.
# Get a free key at: https://console.groq.com/keys
# ---------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...

# ---------------------------------------------------------------------------
# Existing teachers-app environment variables (required to start Next.js dev)
# These control rewrites in next.config.mjs for workspace/telemetry features.
# Override with real URLs in production. Placeholders prevent startup errors.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WORKSPACE_BASE_URL=http://localhost:3001
NEXT_PUBLIC_TELEMETRY_URL=http://localhost:9000
CLOUD_STORAGE_URL=http://localhost:9001

# ---------------------------------------------------------------------------
# Firebase (stub values for local dev — prevents crash on /ai-demo route)
# Replace with real Firebase project credentials for push notifications.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FCM_API_KEY=stub-api-key
NEXT_PUBLIC_FCM_AUTH_DOMAIN=stub-project.firebaseapp.com
NEXT_PUBLIC_FCM_PROJECT_FCM_ID=stub-project-id
NEXT_PUBLIC_FCM_STORAGE_BUCKET=stub-project.appspot.com
NEXT_PUBLIC_FCM_MESSAGING_SENDER=000000000000
NEXT_PUBLIC_FCM_FCM_APP_ID=1:000000000000:web:0000000000000000
NEXT_PUBLIC_FCM_MEASUREMENT_ID=G-XXXXXXXXXX

