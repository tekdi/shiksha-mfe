# ========================================================
# SHIKSHA MFE - LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION
# ========================================================
# Copy this file to .env and populate the required fields.

# -----------------------------------------
# Tenant & Platform Configuration
# -----------------------------------------
NEXT_PUBLIC_TENANT_ID=default_tenant_01
NEXT_PUBLIC_FRAMEWORK_ID=default_framework_01
NEXT_PUBLIC_WORKSPACE_BASE_URL=http://localhost:3000
NEXT_PUBLIC_TELEMETRY_URL=http://localhost:8000
NEXT_PUBLIC_CLOUD_STORAGE_URL=http://localhost:8000/assets

# -----------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shiksha_tenant_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -----------------------------------------
# Queue Configuration (Redis)
# -----------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# -----------------------------------------
# AI Gateway Configuration (Ollama)
# -----------------------------------------
OLLAMA_API_URL=http://localhost:11434
LLM_MODEL_DEFAULT=llama3
