# syntax=docker/dockerfile:1
FROM node:20-slim

WORKDIR /workspace

ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CYPRESS_INSTALL_BINARY=0
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV npm_config_cache="/tmp/.npm"

# Copy package manifests
COPY package*.json ./

# Install PM2 and dependencies using locked versions with scripts ignored
RUN npm install -g pm2@6.0.8 --ignore-scripts && \
    npm ci --legacy-peer-deps --no-audit --no-fund --ignore-scripts && \
    npm cache clean --force

# Copy only the workspace config and sources needed to build learner-web-app
COPY nx.json tsconfig.base.json tsconfig.learner.json jest.preset.js eslint.config.js patch-nx.js .nxignore ./
COPY ecosystem.learner-web-app.config.js ./
COPY libs ./libs
COPY mfes ./mfes
COPY apps/learner-web-app ./apps/learner-web-app

# Fix Nx lockfile parsing bug
RUN node patch-nx.js

# Build apps (the .env secret is mounted only for this step, never baked into the image),
# clean build caches, and give the non-root user ownership
RUN --mount=type=secret,id=env,target=/workspace/.env \
    ./node_modules/.bin/nx run-many --target=build --projects=learner-web-app && \
    rm -rf apps/learner-web-app/.next/cache \
           .nx/cache \
           /tmp/.npm && \
    find /workspace -path /workspace/.env -prune -o -exec chown node:node {} +

# Switch to non-root user provided by node base image
USER node

# learner-web-app
EXPOSE 3003

CMD ["pm2-runtime", "ecosystem.learner-web-app.config.js"]
