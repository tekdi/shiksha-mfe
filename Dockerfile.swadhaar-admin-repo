# syntax=docker/dockerfile:1.4

# ---- Build stage: full toolchain, never shipped ----
FROM node:20-slim AS builder

WORKDIR /workspace

ENV NODE_OPTIONS="--max-old-space-size=8192"
ENV CYPRESS_INSTALL_BINARY=0
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV NEXT_TELEMETRY_DISABLED=1
ENV npm_config_cache="/tmp/.npm"

COPY package*.json ./
RUN npm ci --legacy-peer-deps --no-audit --no-fund --ignore-scripts

# Only the workspace config and sources needed to build this app
COPY nx.json tsconfig.base.json tsconfig.swadhaar.base.json jest.preset.js eslint.config.js ./
COPY libs ./libs
COPY apps/swadhaar-admin-repo ./apps/swadhaar-admin-repo

# The .env secret is mounted only for this step so NEXT_PUBLIC_* vars get inlined
# and the file is never baked into any layer.
RUN --mount=type=secret,id=env,target=/workspace/.env \
    NODE_ENV=production ./node_modules/.bin/nx build swadhaar-admin-repo

# `output: 'standalone'` emits a minimal server plus only the node_modules it traces.
# In a monorepo it nests server.js under the app path, so locate it instead of assuming.
RUN set -e; \
    APP=apps/swadhaar-admin-repo; \
    SA=$APP/.next/standalone; \
    SERVER=$(find "$SA" -name server.js -not -path '*/node_modules/*' | head -1); \
    REL=$(dirname "${SERVER#$SA/}"); \
    mkdir -p /out; \
    cp -r "$SA/." /out/; \
    mkdir -p "/out/$REL/.next"; \
    cp -r "$APP/.next/static" "/out/$REL/.next/static"; \
    if [ -d "$APP/public" ]; then cp -r "$APP/public" "/out/$REL/public"; fi; \
    echo "$REL" > /out/APP_DIR

# ---- Runtime stage: Node + the traced server only ----
FROM node:20-slim AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3004
ENV HOSTNAME=0.0.0.0

WORKDIR /app
COPY --from=builder --chown=node:node /out ./

USER node
EXPOSE 3004

CMD ["sh", "-c", "cd \"/app/$(cat /app/APP_DIR)\" && exec node server.js"]
