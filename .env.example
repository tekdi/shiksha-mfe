# =============================================================================
# Shiksha MFE - Required Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values for your environment.
# Without these variables, the Next.js dev server will crash or API calls
# will fail with "Tenant configuration not found" errors.
# =============================================================================

# --- Core API Endpoint (REQUIRED) ---
# The backend middleware that serves tenant config, user auth, and content APIs.
# Without this, ALL API calls (login, explore, content search) will fail.
NEXT_PUBLIC_MIDDLEWARE_URL=https://your-middleware-url.example.com

# --- Telemetry (OPTIONAL for local dev) ---
# If not set, telemetry rewrites are safely skipped.
NEXT_PUBLIC_TELEMETRY_URL=

# --- Cloud Storage / S3 (OPTIONAL for local dev) ---
# Used for serving uploaded assets. If not set, asset rewrites are skipped.
NEXT_PUBLIC_CLOUD_STORAGE_URL=
CLOUD_STORAGE_URL=

# --- Workspace Base URL (REQUIRED for teacher/admin apps) ---
# The base URL of the workspace MFE for proxy rewrites.
NEXT_PUBLIC_WORKSPACE_BASE_URL=http://localhost:4104

# --- Additional (OPTIONAL) ---
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_COURSE_PLANNER_API_URL=
